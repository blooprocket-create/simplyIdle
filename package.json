{
  "name": "simplyidle",
  "version": "1.0.1",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "npx expo export --platform web && node scripts/patch-web.mjs && npm --prefix wiki install && npm --prefix wiki run docs:generate && npm --prefix wiki run docs:build && node scripts/merge-wiki-into-dist.mjs",
    "wiki:dev": "npm --prefix wiki run docs:dev",
    "wiki:generate": "npm --prefix wiki run docs:generate",
    "wiki:build": "npm --prefix wiki run docs:build",
    "build:android": "npx eas build --platform android --profile production",
    "build:android:apk": "npx eas build --platform android --profile preview",
    "build:ios:preview": "npx eas build --platform ios --profile preview",
    "build:ios": "npx eas build --platform ios --profile production",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install chromium",
    "bundle:check": "node scripts/check-bundle-size.mjs",
    "lint-staged": "lint-staged",
    "prepare": "husky"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~55.0.9",
    "expo-auth-session": "~55.0.12",
    "expo-crypto": "~55.0.12",
    "expo-haptics": "~55.0.11",
    "expo-status-bar": "~55.0.5",
    "expo-web-browser": "~55.0.12",
    "firebase": "^11.8.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.4",
    "react-native-reanimated": "4.2.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.7.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "jest-expo": "^55.0.15",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.2",
    "ts-jest": "^29.4.9",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.58.1"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "private": true
}
