{
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    { "source": "/wiki", "destination": "/wiki/index.html" },
    { "source": "/wiki/", "destination": "/wiki/index.html" },
    { "source": "/wiki/:path*", "destination": "/wiki/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
