{
  "expo": {
    "name": "Simply Idle",
    "slug": "SimplyIdle",
    "scheme": "simplyidle",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0B1A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.blooprocketcreate.simplyidle",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.blooprocketcreate.simplyidle",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "wikiUrl": "https://simply-idle.vercel.app/wiki/",
      "wikiUrlWeb": "https://simply-idle.vercel.app/wiki/",
      "eas": {
        "projectId": "9d7afc17-faa5-4d8c-a34c-94ac8c439204"
      }
    },
    "plugins": [
      "expo-web-browser"
    ]
  }
}
