rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasAdminClaim() {
      return isSignedIn()
        && (
          request.auth.token.admin == true
          || request.auth.token.role == 'admin'
        );
    }

    function hasActiveAdminDoc() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid))
        && get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.active == true;
    }

    function isAdmin() {
      return hasAdminClaim() || hasActiveAdminDoc();
    }

    function isValidGiftPreference(pref) {
      return pref == 'gold' || pref == 'shards' || pref == 'essence';
    }

    function isGuildMember(guildId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/guilds/$(guildId)/members/$(request.auth.uid));
    }

    function isGuildLeader(guildId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/guilds/$(guildId))
        && get(/databases/$(database)/documents/guilds/$(guildId)).data.leaderId == request.auth.uid;
    }

    function isGuildOfficerOrLeader(guildId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/guilds/$(guildId)/members/$(request.auth.uid))
        && (
          get(/databases/$(database)/documents/guilds/$(guildId)/members/$(request.auth.uid)).data.rank == 'leader'
          || get(/databases/$(database)/documents/guilds/$(guildId)/members/$(request.auth.uid)).data.rank == 'officer'
        );
    }

    function isGuildMemberAfterWrite(guildId, uid) {
      return isSignedIn()
        && existsAfter(/databases/$(database)/documents/guilds/$(guildId)/members/$(uid));
    }

    function isSameGuildWith(targetUid) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/userGuild/$(request.auth.uid))
        && exists(/databases/$(database)/documents/userGuild/$(targetUid))
        && get(/databases/$(database)/documents/userGuild/$(request.auth.uid)).data.guildId
            == get(/databases/$(database)/documents/userGuild/$(targetUid)).data.guildId;
    }

    function isLeaderManagingUserGuild(targetUid) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/userGuild/$(request.auth.uid))
        && exists(/databases/$(database)/documents/userGuild/$(targetUid))
        && get(/databases/$(database)/documents/userGuild/$(request.auth.uid)).data.rank == 'leader'
        && get(/databases/$(database)/documents/userGuild/$(request.auth.uid)).data.guildId
            == get(/databases/$(database)/documents/userGuild/$(targetUid)).data.guildId;
    }

    match /users/{userId}/saveSlots/{slotId} {
      // Size limit: save payloads must stay under 900KB (Firestore max is 1MB)
      allow read: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
      allow write: if ((isSignedIn() && request.auth.uid == userId) || isAdmin())
        && request.resource.size < 900 * 1024;
    }

    // Allow admins to read all save slots (collectionGroup queries for dev commands)
    match /{path=**}/saveSlots/{slotId} {
      allow read: if isAdmin();
    }

      // Allow admins to also write to any save slot (for /sendMsg mail injection)
      match /{path=**}/saveSlots/{slotId} {
        allow write: if isAdmin();
      }

      match /userPreferences/{uid} {
        allow read: if isSignedIn() && request.auth.uid == uid;
        allow write: if isSignedIn() && request.auth.uid == uid
          && request.resource.size < 16 * 1024;
      }

    match /characterNames/{nameId} {
      allow get: if isSignedIn();

      allow create: if isSignedIn()
        && !exists(/databases/$(database)/documents/characterNames/$(nameId))
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.normalized is string
        && request.resource.data.displayName is string
        && request.resource.data.accountName is string;

      allow delete: if isSignedIn()
        && resource.data.uid == request.auth.uid;

      allow list, update: if false;
    }

    match /adminUsers/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    // Admin audit log — append-only, admins can read
    match /adminAuditLog/{logId} {
      allow create: if isAdmin();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /leaderboard_global_v1/{uid} {
      allow get, list: if isSignedIn();

      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.level is int
        && request.resource.data.level >= 1
        && (
          !('vipLevel' in request.resource.data)
          || (
            request.resource.data.vipLevel is int
            && request.resource.data.vipLevel >= 0
          )
        )
        && request.resource.data.accountName is string
        && (
          request.resource.data.publicUsername is string
          || request.resource.data.playerName is string
        )
        && request.resource.data.highestWaveReached is int
        && request.resource.data.prestigeCount is int
        && request.resource.data.updatedAt is int
        // Server-side rate limit: at least 10s between submissions
        && (
          !exists(/databases/$(database)/documents/leaderboard_global_v1/$(uid))
          || request.resource.data.updatedAt - resource.data.updatedAt >= 10000
        );

      allow delete: if false;
    }

    match /publicUsernames/{username} {
      allow get: if true;
      allow list: if false;

      allow create, update: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt is int;

      allow delete: if false;
    }

    match /userProfiles/{uid} {
      allow get: if isSignedIn();
      allow list: if false;

      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.updatedAt is int
        && (
          (
            request.resource.data.publicUsername is string
            && request.resource.data.publicUsername.size() >= 3
            && request.resource.data.publicUsername.size() <= 24
          )
          || (
            request.resource.data.giftPreference is string
            && isValidGiftPreference(request.resource.data.giftPreference)
          )
        );

      allow delete: if false;
    }

    match /onlinePresence/{uid} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 24
        && request.resource.data.level is int
        && request.resource.data.level >= 1
        && request.resource.data.level <= 99999
        && request.resource.data.lastSeen is int
        && request.resource.data.lastSeen <= request.time.toMillis();
      allow delete: if false;
    }

    match /chatMutes/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if false;
      allow create, update, delete: if isAdmin();
    }

    match /chatRateLimit/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.lastSentAt is int
        && request.resource.data.lastSentAt <= request.time.toMillis();
      allow delete: if false;
    }

    match /globalChat/{msgId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.level is int
        && request.resource.data.level >= 1
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.sentAt is int
        && request.resource.data.sentAt <= request.time.toMillis()
        && (
          !exists(/databases/$(database)/documents/chatRateLimit/$(request.auth.uid))
          || request.resource.data.sentAt - get(/databases/$(database)/documents/chatRateLimit/$(request.auth.uid)).data.lastSentAt >= 3000
        )
        && !exists(/databases/$(database)/documents/chatMutes/$(request.auth.uid));
      allow update, delete: if isAdmin();

      match /reactions/{uid} {
        allow get, list: if isSignedIn();
        allow create, update: if isSignedIn()
          && request.auth.uid == uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.emoji is string
          && (
            request.resource.data.emoji == '👍'
            || request.resource.data.emoji == '🔥'
            || request.resource.data.emoji == '💪'
            || request.resource.data.emoji == '🎉'
          )
          && request.resource.data.updatedAt is int;
        allow delete: if isSignedIn() && request.auth.uid == uid;
      }
    }

    match /friends/{uid}/requests/{fromUid} {
      allow get, list: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn()
        && request.auth.uid == fromUid
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.fromName is string
        && request.resource.data.createdAt is int;
      allow delete: if isSignedIn() && (request.auth.uid == uid || request.auth.uid == fromUid);
      allow update: if false;
    }

    match /friends/{uid}/outgoing/{toUid} {
      allow get, list: if isSignedIn() && request.auth.uid == uid;
      allow create, update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if isSignedIn() && (request.auth.uid == uid || request.auth.uid == toUid);
    }

    match /friends/{uid}/list/{friendUid} {
      allow get, list: if isSignedIn()
        && (
          request.auth.uid == uid
          || exists(/databases/$(database)/documents/friends/$(uid)/list/$(request.auth.uid))
        );
      allow create, update: if isSignedIn()
        && (request.auth.uid == uid || request.auth.uid == friendUid)
        && request.resource.data.uid == friendUid
        && request.resource.data.addedAt is int;
      allow delete: if isSignedIn() && (request.auth.uid == uid || request.auth.uid == friendUid);
    }

    match /friends/{uid}/giftCooldowns/{cooldownId} {
      allow get, list, create, update, delete: if isSignedIn() && request.auth.uid == uid;
    }

    match /playerMail/{uid}/messages/{messageId} {
      allow get, list, delete: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn()
        && request.resource.data.sentAt is int
        && request.resource.data.subject is string
        && request.resource.data.message is string
        && request.resource.data.from is string
        && request.resource.data.attachments is map
        && (
          exists(/databases/$(database)/documents/friends/$(uid)/list/$(request.auth.uid))
          || (
            request.resource.data.kind == 'guild_reward'
            && isSameGuildWith(uid)
          )
        );
      allow update: if false;
    }

    match /guildLookup/{normalizedName} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.guildId is string
        && request.resource.data.displayName is string
        && request.resource.data.normalizedName is string
        && request.resource.data.tag is string
        && request.resource.data.leaderId == request.auth.uid
        && request.resource.data.leaderName is string
        && request.resource.data.memberCount is int
        && request.resource.data.level is int
        && request.resource.data.isPublic is bool;
      allow update: if isSignedIn()
        && resource.data.guildId is string
        && request.resource.data.guildId == resource.data.guildId
        && request.resource.data.normalizedName == normalizedName
        && isGuildMember(resource.data.guildId);
      allow delete: if isAdmin()
        || (
          isSignedIn()
          && resource.data.guildId is string
          && isGuildLeader(resource.data.guildId)
        );
    }

    match /guilds/{guildId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.leaderId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.normalizedName is string
        && request.resource.data.tag is string
        && request.resource.data.memberCount is int
        && request.resource.data.maxMembers is int
        && request.resource.data.level is int
        && request.resource.data.isPublic is bool;
      allow update: if (
        isGuildLeader(guildId)
        || (
          (isGuildMember(guildId) || isGuildMemberAfterWrite(guildId, request.auth.uid))
          && request.resource.data.name == resource.data.name
          && request.resource.data.normalizedName == resource.data.normalizedName
          && request.resource.data.tag == resource.data.tag
          && request.resource.data.description == resource.data.description
          && request.resource.data.leaderId == resource.data.leaderId
          && request.resource.data.leaderName == resource.data.leaderName
          && request.resource.data.level == resource.data.level
          && request.resource.data.exp == resource.data.exp
          && request.resource.data.maxMembers == resource.data.maxMembers
          && request.resource.data.isPublic == resource.data.isPublic
          && request.resource.data.minLevelToJoin == resource.data.minLevelToJoin
          && (
            !('minPeakProgressToJoin' in resource.data)
            || request.resource.data.minPeakProgressToJoin == resource.data.minPeakProgressToJoin
          )
          && request.resource.data.memberCount is int
          && request.resource.data.memberCount >= 1
          && request.resource.data.memberCount <= request.resource.data.maxMembers
          && request.resource.data.updatedAt is int
        )
      );
      allow delete: if isGuildLeader(guildId) || isAdmin();
    }

    match /guilds/{guildId}/members/{uid} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && (request.resource.data.rank == 'member' || request.resource.data.rank == 'leader');
      allow update: if isSignedIn()
        && (
          request.auth.uid == uid
          || isGuildLeader(guildId)
        );
      allow delete: if isSignedIn()
        && (
          request.auth.uid == uid
          || isGuildLeader(guildId)
          || isAdmin()
        );
    }

    match /guilds/{guildId}/treasuryState/{stateId} {
      allow get, list: if isGuildMember(guildId) || isAdmin();
      allow create: if isGuildMember(guildId)
        && stateId == 'active'
        && request.resource.data.balance is int
        && request.resource.data.balance >= 0
        && request.resource.data.totalDeposited is int
        && request.resource.data.totalDeposited >= 0
        && request.resource.data.totalWithdrawn is int
        && request.resource.data.totalWithdrawn >= 0
        && request.resource.data.dailyWithdrawn is int
        && request.resource.data.dailyWithdrawn >= 0
        && request.resource.data.dailyWindowStart is int
        && request.resource.data.updatedAt is int
        && request.resource.data.updatedByUid == request.auth.uid;
      allow update: if isGuildMember(guildId)
        && stateId == 'active'
        && request.resource.data.balance is int
        && request.resource.data.balance >= 0
        && request.resource.data.totalDeposited is int
        && request.resource.data.totalDeposited >= resource.data.totalDeposited
        && request.resource.data.totalWithdrawn is int
        && request.resource.data.totalWithdrawn >= resource.data.totalWithdrawn
        && request.resource.data.dailyWithdrawn is int
        && request.resource.data.dailyWithdrawn >= 0
        && request.resource.data.dailyWindowStart is int
        && request.resource.data.updatedAt is int
        && request.resource.data.updatedByUid == request.auth.uid
        && (
          (
            // Regular members: can only deposit (increase balance)
            request.resource.data.balance >= resource.data.balance
            && request.resource.data.totalWithdrawn == resource.data.totalWithdrawn
            && request.resource.data.dailyWithdrawn == resource.data.dailyWithdrawn
            && request.resource.data.dailyWindowStart == resource.data.dailyWindowStart
          )
          || isGuildOfficerOrLeader(guildId)
        );
      allow delete: if false;
    }

    match /guilds/{guildId}/treasuryLedger/{entryId} {
      allow get, list: if isGuildMember(guildId) || isAdmin();
      allow create: if isGuildMember(guildId)
        && request.resource.data.type is string
        && (
          request.resource.data.type == 'deposit'
          || request.resource.data.type == 'withdrawal'
        )
        && request.resource.data.amount is int
        && request.resource.data.amount > 0
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorName is string
        && request.resource.data.actorRank is string
        && (
          request.resource.data.actorRank == 'leader'
          || request.resource.data.actorRank == 'officer'
          || request.resource.data.actorRank == 'member'
        )
        && request.resource.data.reason is string
        && request.resource.data.createdAt is int
        && (
          request.resource.data.type != 'withdrawal'
          || isGuildOfficerOrLeader(guildId)
        );
      allow update, delete: if false;
    }

    match /guilds/{guildId}/boss/{bossId} {
      allow get, list: if isGuildMember(guildId) || isAdmin();
      allow create, update: if isGuildMember(guildId)
        && request.resource.data.updatedAt is int;
      allow delete: if isGuildLeader(guildId) || isAdmin();
    }

    match /guilds/{guildId}/events/{eventId} {
      allow get, list: if isGuildMember(guildId) || isAdmin();
      allow create: if isGuildLeader(guildId)
        && request.resource.data.type is string
        && request.resource.data.status is string
        && request.resource.data.startedAt is int
        && request.resource.data.endsAt is int;
      allow update: if isGuildMember(guildId)
        && request.resource.data.updatedAt is int
        && (
          // Leaders can modify any event field
          isGuildLeader(guildId)
          || (
            // Regular members can only update updatedAt — no event metadata changes
            request.resource.data.type == resource.data.type
            && request.resource.data.status == resource.data.status
            && request.resource.data.startedAt == resource.data.startedAt
            && request.resource.data.endsAt == resource.data.endsAt
          )
        );
      allow delete: if isGuildLeader(guildId) || isAdmin();
    }

    match /guilds/{guildId}/events/{eventId}/contrib/{uid} {
      allow get, list: if isGuildMember(guildId) || isAdmin();
      allow create: if isGuildMember(guildId)
        && request.auth.uid == uid
        && request.resource.data.totalContributed is int
        && request.resource.data.totalContributed >= 0
        && request.resource.data.updatedAt is int
        && request.resource.data.lastContributedAt is int;
      allow update: if isGuildMember(guildId)
        && request.auth.uid == uid
        && request.resource.data.totalContributed is int
        && request.resource.data.totalContributed >= resource.data.totalContributed
        && request.resource.data.updatedAt is int
        && request.resource.data.lastContributedAt is int;
      allow delete: if isGuildLeader(guildId) || isAdmin();
    }

    match /guilds/{guildId}/chat/{msgId} {
      allow get, list: if isGuildMember(guildId) || isAdmin();
      allow create: if isGuildMember(guildId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 300
        && request.resource.data.sentAt is int
        && request.resource.data.sentAt <= request.time.toMillis()
        && (
          !exists(/databases/$(database)/documents/guildChatRateLimit/$(request.auth.uid))
          || request.resource.data.sentAt - get(/databases/$(database)/documents/guildChatRateLimit/$(request.auth.uid)).data.lastSentAt >= 3000
        );
      allow update, delete: if isGuildLeader(guildId) || isAdmin();
    }

    match /guildChatRateLimit/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.lastSentAt is int
        && request.resource.data.lastSentAt <= request.time.toMillis();
      allow delete: if false;
    }

    match /guildInviteRateLimit/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.lastInvitedAt is int
        && request.resource.data.lastInvitedAt <= request.time.toMillis();
      allow delete: if false;
    }

    match /guildInvites/{uid}/incoming/{inviteId} {
      allow get, list: if isSignedIn() && request.auth.uid == uid;

      allow create: if isSignedIn()
        && request.resource.data.inviterUid == request.auth.uid
        && request.resource.data.invitedUid == uid
        && request.resource.data.guildId is string
        && isGuildOfficerOrLeader(request.resource.data.guildId)
        && (
          !exists(/databases/$(database)/documents/guildInviteRateLimit/$(request.auth.uid))
          || request.resource.data.createdAt - get(/databases/$(database)/documents/guildInviteRateLimit/$(request.auth.uid)).data.lastInvitedAt >= 10000
        )
        && request.resource.data.guildName is string
        && request.resource.data.guildTag is string
        && request.resource.data.inviterName is string
        && request.resource.data.minLevelToJoin is int
        && request.resource.data.minLevelToJoin >= 1
        && request.resource.data.minPeakProgressToJoin is int
        && request.resource.data.minPeakProgressToJoin >= 1
        && request.resource.data.isPublic is bool
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is int
        && request.resource.data.expiresAt is int
        && request.resource.data.updatedAt is int;

      allow update: if isSignedIn()
        && request.auth.uid == uid
        && resource.data.invitedUid == uid
        && request.resource.data.invitedUid == resource.data.invitedUid
        && request.resource.data.inviterUid == resource.data.inviterUid
        && request.resource.data.guildId == resource.data.guildId
        && request.resource.data.guildName == resource.data.guildName
        && request.resource.data.guildTag == resource.data.guildTag
        && request.resource.data.inviterName == resource.data.inviterName
        && request.resource.data.minLevelToJoin == resource.data.minLevelToJoin
        && request.resource.data.minPeakProgressToJoin == resource.data.minPeakProgressToJoin
        && request.resource.data.isPublic == resource.data.isPublic
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.expiresAt == resource.data.expiresAt
        && request.resource.data.updatedAt is int
        && request.resource.data.respondedAt is int
        && (
          // Accept requires the invite to not be expired
          (
            request.resource.data.status == 'accepted'
            && resource.data.expiresAt > request.time.toMillis()
          )
          || request.resource.data.status == 'declined'
          || request.resource.data.status == 'expired'
        );

      allow delete: if false;
    }

    match /userGuild/{uid} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create, update, delete: if isSignedIn()
        && (
          request.auth.uid == uid
          || isLeaderManagingUserGuild(uid)
        );
    }
  }
}
